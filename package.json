{
  "name": "wordfrog",
  "main": "expo-router/entry",
  "version": "1.0.9",
  "scripts": {
    "start": "expo start --tunnel",
    "predeploy": "npx expo export -p web  && echo 'wordfrog.superjeffc.com' > dist/CNAME && touch dist/.nojekyll && echo \"!**/node_modules\" > dist/.gitignore",
    "deploy": "npx gh-pages -d dist  --src \"**/*\" --dotfiles",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ship-android": "eas build --platform android --profile production",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "deploy:leaderboard": "cd leaderboard-worker && npx -y wrangler deploy",
    "deploy:dictionary": "cd dictionary-worker && npx -y wrangler deploy",
    "test": "jest",
    "test:worker": "npm test --prefix dictionary-worker"
  },
  "dependencies": {
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.25",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.8",
    "gh-pages": "^6.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eas-cli": "^27.10.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "react-test-renderer": "19.3.0",
    "test-renderer": "^1.3.0",
    "typescript": "~5.9.3"
  },
  "private": true,
  "overrides": {
    "@expo/bunyan": {
      "uuid": "^11.1.1"
    },
    "@expo/config": {
      "glob": "^14.0.6"
    },
    "@expo/config-plugins": {
      "glob": "^14.0.6"
    },
    "@expo/fingerprint": {
      "minimatch": "^11.0.9"
    },
    "@expo/ngrok": {
      "uuid": "^11.1.1"
    },
    "@expo/rudder-sdk-node": {
      "uuid": "^11.1.1"
    },
    "@jest/reporters": {
      "glob": "^14.0.6"
    },
    "@oclif/core@^4.0.0": {
      "minimatch": "^11.0.9"
    },
    "eas-cli": {
      "diff": "^8.0.4",
      "ts-deepmerge": "^8.0.0"
    },
    "jest-config": {
      "glob": "^14.0.6"
    },
    "jest-runtime": {
      "glob": "^14.0.6"
    },
    "sucrase": {
      "glob": "^14.0.6"
    },
    "test-exclude@^7.0.0": {
      "glob": "^14.0.6",
      "minimatch": "^11.0.9"
    },
    "xcode@^3.0.0": {
      "uuid": "^11.1.1"
    }
  },
  "engines": {
    "node": ">=22.16"
  }
}
